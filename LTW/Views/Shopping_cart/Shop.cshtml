
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Shop</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        /* 1. Header Đen */
        .header {
            background-color: #000;
            color: #fff;
            height: 70px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 50px;
        }

        /* Logo */
        .logo a {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #fff;
            text-decoration: none;
            font-size: 24px;
            font-weight: bold;
            font-style: italic;
            letter-spacing: 1px;
        }

        .logo i {
            font-size: 28px;
        }

        /* Menu điều hướng */
        .nav-menu {
            display: flex;
            list-style: none;
            gap: 25px;
            align-items: center;
        }

            .nav-menu a {
                color: #fff;
                text-decoration: none;
                font-size: 15px;
                font-weight: 500;
                transition: color 0.2s;
            }

                .nav-menu a:hover {
                    color: #0088cc;
                }

            .nav-menu i.fa-chevron-down {
                font-size: 11px;
                margin-left: 3px;
            }

        /* Icon nhóm bên phải */
        .header-icons {
            display: flex;
            align-items: center;
            gap: 20px;
        }

            .header-icons a {
                color: #fff;
                text-decoration: none;
                font-size: 16px;
                transition: color 0.2s;
            }

                .header-icons a:hover {
                    color: #0088cc;
                }

        /* 2. Nội dung Giỏ hàng trống */
        .cart-empty-container {
            min-height: 400px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 80px 20px;
            text-align: center;
        }

        .cart-empty-message {
            font-size: 16px;
            color: #333;
            margin-bottom: 25px;
        }

        .btn-return-shop {
            background-color: #0088A8; /* Màu xanh ngọc lục bảo đặc trưng */
            color: #fff;
            padding: 12px 28px;
            font-size: 15px;
            font-weight: bold;
            text-decoration: none;
            border-radius: 2px;
            letter-spacing: 0.5px;
            transition: background-color 0.2s ease;
            display: inline-block;
        }

            .btn-return-shop:hover {
                background-color: #006b85;
            }
    </style>
</head>
<body>

    

        <!-- Icon bên phải -->
        <div class="header-icons">
            <a href="#" title="Tìm kiếm"><i class="fa-solid fa-magnifying-glass"></i></a>
            <a href="#" title="Tài khoản"><i class="fa-regular fa-user"></i></a>
            <a href="#" title="Giỏ hàng"><i class="fa-solid fa-bag-shopping"></i></a>
        </div>
    </header>
  
    <!-- Khối Giỏ Hàng Trống -->
    <main class="cart-empty-container">
        <p class="cart-empty-message">Chưa có sản phẩm nào trong giỏ hàng.</p>
        <a href="#" class="btn-return-shop">QUAY TRỞ LẠI CỬA HÀNG</a>
    </main>

</body>
</html>
