<body>
    <div class="laptop-page">
        @*Header lọc theo kích thước*@
        <div class="size-filter-header">
            <h1>Balo laptop chính hãng: đủ cỡ 14, 15.6, 17 inch</h1>
            <p>Chọn balo theo cỡ laptop của bạn:</p>
            <div class="size-buttons">
                <a href="#" class="btn-size">14 INCH</a>
                <a href="#" class="btn-size">15.6 INCH</a>
                <a href="#" class="btn-size">17 INCH</a>
            </div>
            <div class="policy-text">
                Freeship toàn quốc từ 499.000 đ · Đổi trả trong 7 ngày · <a href="#">Chính sách bảo hành</a>
            </div>
        </div>

        @*Thanh thông tin & Sắp xếp*@
        <div class="top-bar">
            <div class="breadcrumb">
                TRANG CHỦ / BALO / <strong>BALO LAPTOP</strong>
            </div>
            <div class="sort-box">
                <span>Hiển thị 1–32 của 100 kết quả </span>
                <select>
                    <option>Sắp xếp theo mới nhất</option>
                    <option>Giá từ thấp đến cao</option>
                    <option>Giá từ cao đến thấp</option>
                </select>
            </div>
        </div>

        @*Layout chính*@
        <div class="main-layout">
            @*Sidebar lọc bên trái*@
            @*KÍCH THƯỚC BALO*@
            <aside class="sidebar">
                <div class="filter-title">KÍCH THƯỚC LAPTOP</div>
                <ul class="filter-list">
                    <li><a href="#">14 inch</a> <span class="count">(8)</span></li>
                    <li><a href="#">15.6 inch</a> <span class="count">(46)</span></li>
                    <li><a href="#">17 inch</a> <span class="count">(7)</span></li>
                    <li><a href="#">M</a> <span class="count">(1)</span></li>
                </ul>
                @*GIÁ*@
                <div class="filter-title">GIÁ</div>
                <ul class="filter-list">
                    <li><a href="#">Từ 0 - 300.000vnđ</a></li>
                    <li><a href="#">Từ 300.000vnđ - 500.000vnđ</a></li>
                    <li><a href="#">Từ 500.000vnđ - 1.000.000vnđ</a></li>
                    <li><a href="#">Từ 1.000.000vnđ - 3.000.000vnđ</a></li>
                    <li><a href="#">Từ 3.000.000vnđ - 5.000.000vnđ</a></li>
                </ul>

                @*DANH MỤC SẢN PHẨM*@
                <div class="filter-title">DANH MỤC SẢN PHẨM</div>
                <div class="category-tree">
                    <ul class="category-list">

                        <!-- Balo laptop (Active - Đang được chọn) -->
                        <li class="has-child open active">
                            <div class="cat-item">
                                <a href="#" class="cat-title active">Balo laptop</a>
                            </div>
                        </li>

                        <!-- Balo du lịch-->
                        <li class="has-child">
                            <div class="cat-item">
                                <a href="#" class="cat-title">Balo du lịch</a>

                            </div>
                        </li>

                        <!-- Balo máy ảnh-->
                        <li class="has-child">
                            <div class="cat-item">
                                <a href="#" class="cat-title">Balo máy ảnh</a>

                            </div>
                        </li>

                        <!-- Túi xách-->
                        <li class="has-child">
                            <div class="cat-item">
                                <a href="#" class="cat-title">Túi xách</a>

                            </div>
                        </li>

                        <!-- Phụ Kiện -->
                        <li>
                            <a href="#" class="cat-title">Phụ Kiện</a>
                        </li>
                    </ul>
                </div>
            </aside>

            @*Lưới sản phẩm bên phải*@
            <main class="product-grid">
                @*Sản phẩm 1*@
                <div class="product-card">
                    <div class="img-box">
                        <span class="badge-sale">-30%</span>
                        <img src="https://balosaigon.com/wp-content/uploads/2026/09/The-North-Face-Commuter-Daypack-4.jpg" alt="Balo Laptop The North Face Commuter Daypack">
                    </div>
                    <a href="#" class="product-name">Balo Laptop The North Face Commuter Daypack</a>
                    <div class="price-box">
                        <span class="old-price">1.490.000 VND</span>
                        <span class="current-price">1.050.000 VND</span>
                    </div>
                </div>

                @*Sản phẩm 2*@
                <div class="product-card">
                    <div class="img-box">
                        <span class="badge-sale">-23%</span>
                        <img src="https://shopta.vn/images/2024/02/balo-fjallraven-skule-28-2V.png" alt="Balo Laptop Fjallraven Skule 28">
                    </div>
                    <a href="#" class="product-name">Balo Laptop Fjallraven Skule 28</a>
                    <div class="price-box">
                        <span class="old-price">1.100.000 VND</span>
                        <span class="current-price">849.000 VND</span>
                    </div>
                </div>

                @*Sản phẩm 3*@
                <div class="product-card">
                    <div class="img-box">
                        <img src="https://cdn2.cellphones.com.vn/x/media/catalog/product/t/e/text_ng_n_-_2023-09-20t231559.385.png" alt="Balo Laptop Kmore The Micah">
                    </div>
                    <a href="#" class="product-name">Balo Laptop Kmore The Micah</a>
                    <div class="price-box">
                        <span class="current-price">500.000 VND</span>
                    </div>
                </div>

                <!-- Sản phẩm 4 -->
                <div class="product-card">
                    <div class="img-box">
                        <img src="https://topbag.vn/media/images/large/san-pham/balo/mikkor/the-louie/balo-laptop-nam-nu-mikkor-the-louie-grey-1.jpg" alt="Balo Laptop Mikkor The Louie">
                    </div>
                    <a href="#" class="product-name">Balo Laptop Mikkor The Louie</a>
                    <div class="price-box">
                        <span class="current-price">750.000 VND</span>
                    </div>
                </div>
            </main>
        </div>
    </div>
</body>
</html>

