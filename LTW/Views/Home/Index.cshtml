@{
    ViewBag.Title = "";
}

<!-- BANNER QUẢNG CÁO -->
<div style="background-color: #2b2f38; color: white; padding: 40px 20px; text-align: center; border-radius: 6px; margin-bottom: 30px;">
    <h1 style="font-size: 28px; margin-bottom: 10px; color: #e31837;">BỘ SƯU TẬP BALO DU LỊCH & LAPTOP 2026</h1>
    <p style="font-size: 16px;">Giảm giá lên đến 30% cho tất cả các dòng Balo chống nước chính hãng!</p>
</div>

<!-- TIÊU ĐỀ MỤC -->
<h2 style="font-size: 20px; font-weight: bold; color: #1f2229; border-bottom: 2px solid #e31837; padding-bottom: 8px; margin-bottom: 20px; text-transform: uppercase;">
    Sản Phẩm Nổi Bật
</h2>

<!-- DANH SÁCH SẢN PHẨM -->
<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 20px;">

    <!-- Sản phẩm 1 -->
    <div style="border: 1px solid #e2e8f0; border-radius: 6px; padding: 15px; text-align: center; background: #fff;">
        <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSGb44tx25RPitIKUEfVE2FfHvgs-ybhZ0vwcCzquctFwQ2BuQiGaWyIqlk&s=10" alt="Balo Laptop" style="width: 100%; height: 180px; object-fit: contain; margin-bottom: 10px;" />
        <h3 style="font-size: 14px; font-weight: 600; height: 40px; overflow: hidden; margin-bottom: 8px;">Balo Laptop Chống Nước Premium</h3>
        <p style="color: #e31837; font-weight: bold; font-size: 16px; margin-bottom: 10px;">550.000 đ</p>
        @Html.ActionLink("XEM CHI TIẾT", "ChiTiet", "Home", new { id = 1 }, new { @style = "display: inline-block; background: #1f2229; color: #fff; padding: 6px 12px; border-radius: 4px; font-size: 12px; font-weight: bold; text-decoration: none;" })
    </div>

    <!-- Sản phẩm 2 -->
    <div style="border: 1px solid #e2e8f0; border-radius: 6px; padding: 15px; text-align: center; background: #fff;">
        <img src="https://down-vn.img.susercontent.com/file/vn-11134207-81ztc-mqfq251oeole40" alt="Balo Du Lịch" style="width: 100%; height: 180px; object-fit: contain; margin-bottom: 10px;" />
        <h3 style="font-size: 14px; font-weight: 600; height: 40px; overflow: hidden; margin-bottom: 8px;">Balo Du Lịch Phượt Dung Tích 40L</h3>
        <p style="color: #e31837; font-weight: bold; font-size: 16px; margin-bottom: 10px;">850.000 đ</p>
        @Html.ActionLink("XEM CHI TIẾT", "ChiTiet", "Home", new { id = 2 }, new { @style = "display: inline-block; background: #1f2229; color: #fff; padding: 6px 12px; border-radius: 4px; font-size: 12px; font-weight: bold; text-decoration: none;" })
    </div>

    <!-- Sản phẩm 3 -->
    <div style="border: 1px solid #e2e8f0; border-radius: 6px; padding: 15px; text-align: center; background: #fff;">
        <img src="https://bizweb.dktcdn.net/100/044/266/files/tui-dung-giay-the-thao-hier-sportwear-15.jpg?v=1720445119204" alt="Túi Chéo" style="width: 100%; height: 180px; object-fit: contain; margin-bottom: 10px;" />
        <h3 style="font-size: 14px; font-weight: 600; height: 40px; overflow: hidden; margin-bottom: 8px;">Túi Đeo Chéo Thể Thao Nam</h3>
        <p style="color: #e31837; font-weight: bold; font-size: 16px; margin-bottom: 10px;">290.000 đ</p>
        @Html.ActionLink("XEM CHI TIẾT", "ChiTiet", "Home", new { id = 3 }, new { @style = "display: inline-block; background: #1f2229; color: #fff; padding: 6px 12px; border-radius: 4px; font-size: 12px; font-weight: bold; text-decoration: none;" })
    </div>

</div>